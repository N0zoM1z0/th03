+def validate_inventory(owners, cohort):
+    need(len(cohort) == 45 and len({o['unit_id'] for o in cohort}) == 45 and
+         sum(o['size'] for o in cohort) == 13221, 'fixed 45-owner / 13221-byte cohort')
+    need(IRAND not in {o['unit_id'] for o in cohort}, 'IRAND remains excluded vendor context')
+    need(len(owners) == 45 and len({o['unit_id'] for o in owners}) == 45 and
+         {o['unit_id'] for o in owners} == {o['unit_id'] for o in cohort},
+         'same-ID complete owner inventory')
+    expected = {o['unit_id']: o for o in cohort}
+    spans = []
+    for owner in owners:
+        need({k: owner[k] for k in ('unit_id', 'source', 'start', 'size', 'origin')}
+             == expected[owner['unit_id']], 'owner descriptor drift')
+        need(owner['origin'] == 'authored' and owner['size'] > 0 and owner['start'] >= 0,
+             'owner scope')
+        start, end = owner['start'], owner['start'] + owner['size']
+        need(not any(start < hi and lo < end for lo, hi in spans), 'owner overlap')
+        spans.append((start, end))

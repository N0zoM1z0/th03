+def owner_lineage(root, work, source, producer, obj):
+    """Bind direct includes, one byte-preserving source split, and PFOPEN alias."""
+    deps = {dependency_name(n) for n in obj['dependency_paths']}
+    raw = regular(root, source).read_bytes()
+    if source == SELECTION:
+        marker = b'// Coincidentally, these were the only characters available in the trial'
+        need(raw.count(marker) == 1, 'selection split anchor')
+        split = raw.index(marker)
+        fragments = {'th03/selhelp.cpp': ('probe/select155_helper.inl', raw[:split]),
+                     'th03/seltail.cpp': ('probe/select155_tail.inl', raw[split:])}
+        need(producer['source'] in fragments, 'selection split producer')
+        consumed, expected = fragments[producer['source']]
+        need((work/'probe/select155_helper.inl').read_bytes() +
+             (work/'probe/select155_tail.inl').read_bytes() == raw,
+             'whole selection source reconstruction')
+        transform = 'byte-preserving-two-file-split'
+    else:
+        consumed = 'th03/formats/pfopen.asm' if source == PFOPEN else source
+        expected = raw
+        transform = 'identity-path-alias' if source == PFOPEN else 'direct-maintained-include'
+        if source == PFOPEN:
+            need(producer['source'] == 'th03_optail.asm', 'PFOPEN current mixed tail producer')
+    need(dependency_name(consumed) in deps and (work/consumed).read_bytes() == expected,
+         'current maintained source-to-OMF lineage ' + source)
+    return dict(maintained_source=source, maintained_sha256=sha(raw), consumed_source=consumed,
+                consumed_sha256=sha(expected), transform=transform)
+

+def input_bindings(root, files=None, lineage_pins=()):
+    """Complete dated proof closure plus current source, policy and executable helpers."""
+    cold, packing = proofs(root)
+    required = {}
+    def add(item):
+        q = {k: item[k] for k in ('path', 'bytes', 'sha256')}
+        need(q['path'] not in required or required[q['path']] == q,
+             'conflicting proof binding ' + q['path'])
+        required[q['path']] = q
+    for proof in (cold, packing):
+        for q in proof['pins']:
+            add(q)
+    names = set(MANDATORY) | set(HELPER_PATHS)
+    for q in cold['source_stage_modules']:
+        add(q)
+        # These reviewed constant dictionaries include the composer inputs which
+        # are not themselves copied into the generated 330-file source tree.
+        tree = ast.parse(checked(root, q))
+        for node in tree.body:
+            if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and
+                    t.id == 'INPUT_HASHES' for t in node.targets):
+                for name, digest in ast.literal_eval(node.value).items():
+                    current = pin(root, name)
+                    need(current['sha256'] == digest, 'current stage input ' + name)
+                    add(current)
+    for dependency in cold['source_dependencies']:
+        add(dependency)
+        for q in json.loads(checked(root, dependency))['files']:
+            add(q)  # Current installed overlays must still match their reviewed package.
+    names.update(n for n in cold['source_inventory'] if n.startswith(('src/', 'compat/')))
+    names.update(o['source'] for o in current_cohort(root, files))
+    for name in names:
+        add(pin(root, name, files))
+    for q in lineage_pins:
+        add(q)
+    # The old publication is neither overwritten nor used to inherit current
+    # credit. Its cohort's immutable contents are still a baseline reference.
+    add(pin(root, 'config/op_decoded_acceptance/cohort.json'))
+    return [required[n] for n in sorted(required)]
+

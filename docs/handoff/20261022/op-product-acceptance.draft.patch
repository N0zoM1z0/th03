+def descriptor(unit):
+    need(unit['artifact'] == 'th03-op' and unit['segment'].startswith('decoded:'),
+         'decoded OP scope')
+    need(unit['state'] == 'source-present' and unit['origin'] == 'authored' and
+         unit['source'] and not unit['file_offset'] and
+         unit['boundary_state'] in ('reviewed', 'shared'), 'eligible maintained owner')
+    need(int(unit['size'], 0) == int(unit['compare_size'], 0) > 0,
+         'complete maintained owner extent')
+    return dict(unit_id=unit['id'], source=unit['source'],
+                start=int(unit['segment'].split(':')[1], 16)*16+int(unit['offset'], 0),
+                size=int(unit['compare_size'], 0), origin=unit['origin'])

+def evidence_rows(owners, gates, policy, pins, evidence, observed_utc):
+    classes = {p['id']: p for p in policy['oracles']}
+    digest = sha(json.dumps(pins, sort_keys=True).encode())
+    witnesses = {p['path']: p for p in evidence}
+    result = {}
+    for owner in owners:
+        rows = {}
+        for gate in GATES:
+            global_gate = gate in policy['policy']['global_evidence_oracles']
+            artifact_gate = gate in policy['policy']['artifact_evidence_oracles']
+            key = 'ev-op-current-' + owner['unit_id'] + '-' + gate
+            location = gates[gate]['witness']
+            rows[key] = dict(
+                id=key, claim_id=owner['unit_id'], oracle=gate,
+                artifact='' if global_gate else 'th03-op',
+                unit_id='' if global_gate or artifact_gate else owner['unit_id'],
+                extent_start='' if global_gate or artifact_gate else str(owner['start']),
+                extent_size='' if global_gate or artifact_gate else str(owner['size']),
+                location=location, evidence_class=classes[gate]['accepts_evidence_classes'][0],
+                result='pass', tool='current OP physical owner audit and dated cold receipt replay',
+                command='python3 scripts/replay_th03_op_product_acceptance.py --prepare REVIEW_DIRECTORY',
+                input_sha256=owner['rounds'][0]['target_sha256'] if gate == 'raw-bytes' else digest,
+                output_sha256=owner['rounds'][0]['candidate_sha256'] if gate == 'raw-bytes'
+                              else witnesses[location]['sha256'],
+                observed_utc=observed_utc)
+        result[owner['unit_id']] = rows
+    return result
+
+
+def status(accepted, owners):
+    return dict(repository_local=True, factory_accepted=False, target_provenance='candidate-local-attested',
+                product_exact=accepted, mixed_physical_exact_bytes=36041 if accepted else 0,
+                mixed_authored_credit_bytes=0, product_evidence_axis='separate-source-fed-packing',
+                cold_round_exes_directly_packed=False, decoded_exact_units=45 if accepted else 0,
+                decoded_authored_bytes=13221 if accepted else 0, decoded_library_bytes=0,
+                decoded_exact_unit_ids=sorted(o['unit_id'] for o in owners) if accepted else [],
+                canonical_credit_changed=False, whole_game_percentage=None,
+                whole_game_code_denominator_known=False, reviewed_proof_ready=True)
+
+
+def verify(root, publication, files=None, allow_review=False, full_replay=False):
+    root = Path(root)
+    helper_bindings(root, files)
+    p = publication
+    need(p['schema'] == 'op-product-acceptance-publication-v1', 'publication schema')
+    accepted = p['state'] == 'repository-local-accepted'
+    need(accepted or (allow_review and p['state'] == 'review-ready'), 'pending publication')
+    need(p['scope'] == 'current-45-decoded-owners-and-separate-mixed-product' and
+         p['target_provenance'] == 'candidate-local-attested', 'scope/provenance')
+    need(p['factory_accepted'] is False and p['canonical_credit_changed'] is False and
+         p['new_authored_credit_bytes'] == 0 and p['whole_game_percentage'] is None and
+         p['whole_product_ownership'] is False and p['runtime_rerun'] is False,
+         'accounting boundary')
+    cohort = current_cohort(root, files)
+    validate_inventory(p['owners'], cohort)
+    pins = p['input_bindings']
+    need(len(pins) == len({q['path'] for q in pins}), 'duplicate input bindings')
+    for q in pins:
+        checked(root, q, files)
+    from lib.op_diet_lineage import verify_diet_lineage
+    from lib.pc98 import describe_blob
+    identity, identity_pins = verify_diet_lineage(root, describe_blob)
+    need(pins == input_bindings(root, files, identity_pins), 'mandatory current/historical input closure')
+    evidence = p['evidence_bindings']
+    need(len(evidence) == len({q['path'] for q in evidence}), 'duplicate witnesses')
+    by_path = {q['path']: q for q in evidence}
+    for q in evidence:
+        checked(root, q)
+    need(p['inputs'] == {q['path']: q['sha256'] for q in pins+evidence}, 'retention mirror')
+    policy = tomllib.loads(regular(root, 'config/oracles.toml').read_text())
+    need(set(policy['policy']['exact_requires']) == set(GATES), 'eleven current required gates')
+    need(set(p['gates']) == set(GATES), 'eleven owner gate witnesses')
+    classes = {r['id']: r for r in policy['oracles']}
+    for gate, entry in p['gates'].items():
+        need(entry['result'] == 'pass' and entry['witness'] in by_path and
+             entry['evidence_class'] in classes[gate]['accepts_evidence_classes'], 'gate witness/class')
+    def witness(gate):
+        return checked(root, by_path[p['gates'][gate]['witness']])
+    audit = physical_audit(root, cohort)
+    need(audit['owners'] == p['owners'] and json.loads(witness('boundary-ownership')) == audit,
+         'recomputed current cold owner/object/MAP audit')
+    for gate in ('layout-relocations', 'raw-bytes', 'object-format-integrity'):
+        need(p['gates'][gate]['witness'] == p['gates']['boundary-ownership']['witness'],
+             'actual physical witness scope')
+    need(json.loads(witness('target-identity')) == identity and
+         p['gates']['format-integrity']['witness'] == p['gates']['target-identity']['witness'],
+         'independent stored-to-decoded identity and format lineage')
+    need(json.loads(witness('toolchain-identity')) == tool_identity(root), 'toolchain witness drift')
+    cold_result = json.loads(witness('cold-build-determinism'))
+    validate_cold_witness(cold_result)
+    for gate in ('toolchain-replay', 'cold-aggregate-replay'):
+        need(p['gates'][gate]['witness'] == p['gates']['cold-build-determinism']['witness'],
+             'actual source-cold scope')
+    cold = load_module(root, 'scripts/replay_th03_op_fullcold_exact.py')
+    current_source = cold.check_current_sources(root)
+    need(current_source == p['current_source_compatibility'] and
+         current_source['current_source_composition_pass'] and current_source['source_files'] == 330,
+         'current maintained source compatibility')
+    pack_result = json.loads(checked(root, by_path[p['packing_witness']]))
+    validate_packing_witness(pack_result)
+    lineage = packing_lineage(root, audit['cold_products'])
+    need(p['packing_lineage'] == lineage and
+         json.loads(checked(root, by_path[p['packing_lineage_witness']])) == lineage,
+         'explicit separate source-fed packing lineage')
+    if full_replay:
+        need(cold.replay(root) == cold_result, 'full62 actual cold replay')
+        pack = load_module(root, 'scripts/replay_th03_op_source_packing.py')
+        need(pack.replay(root) == pack_result, 'full5 actual source packing replay')
+    tracking, log = ledger_replay(root)
+    need(witness('ledger-consistency').decode() == log, 'ledger witness drift')
+    expected = evidence_rows(p['owners'], p['gates'], policy, pins, evidence, p['observed_utc'])
+    need(p['owner_oracles'] == expected, 'same-ID owner Oracle row bindings')
+    for owner in p['owners']:
+        rows = p['owner_oracles'][owner['unit_id']]
+        passed = tracking.accepted_oracle_passes(
+            list(rows), rows, classes, set(policy['policy']['non_acceptance_evidence_classes']),
+            artifact='th03-op', unit_id=owner['unit_id'], extent_start=owner['start'],
+            extent_size=owner['size'], global_evidence_oracles=set(policy['policy']['global_evidence_oracles']),
+            artifact_evidence_oracles=set(policy['policy']['artifact_evidence_oracles']))
+        need(set(GATES) <= passed, 'complete owner Oracle scope/class/replay metadata')
+    return status(accepted, cohort)
+
+
+def load_status(root, publication_path=PUBLICATION):

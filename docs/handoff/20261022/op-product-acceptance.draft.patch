+def physical_audit(root, cohort):
+    from lib.pc98 import parse_mz
+    from lib.omf import describe_omf
+    root = Path(root)
+    cold, _ = proofs(root)
+    owners = [dict(o, coordinate_space='decoded-load', canonical_file_offset=None, rounds=[])
+              for o in cohort]
+    objects, products = [], []
+    previous_objects = {}
+    for rnd, manifest_pin in enumerate(cold['final_manifests'], 1):
+        manifest = json.loads(checked(root, manifest_pin))
+        work = root / manifest['work']
+        plan = json.loads(checked(root, manifest['cold_plan']))
+        producers = [p for p in plan['producers'] if p['phase'] != 'link']
+        need(len(producers) == 30 and len({p['source'] for p in producers}) == 30 and
+             len({p['output'] for p in producers}) == 30, 'thirty actual fresh producers')
+        source_meta = manifest['repeat_inputs']
+        staged = {dependency_name(n): n for n in source_meta}
+        need(len(staged) == 330, '330 unique materialized source paths')
+        declared_tools = {dependency_name(p['path']): p for p in manifest['toolchain_inputs']}
+        object_by_source = {}
+        for producer in producers:
+            raw = (work / producer['output']).read_bytes()
+            obj = describe_omf(raw)
+            expected = ('Turbo Assembler  Version 5.0' if producer['source'].endswith('.asm')
+                        else 'TC86 Borland C++ 4.02')
+            need(obj['valid'] and obj['translator_comments'] == [expected], 'fresh OMF producer')
+            need(dependency_name(obj['module_name']) == dependency_name(producer['source']) and
+                 obj['dependency_paths'] and
+                 dependency_name(obj['dependency_paths'][0]) == dependency_name(producer['source']),
+                 'OMF physical source module')
+            for dep in obj['dependency_paths']:
+                key = dependency_name(dep)
+                if key.startswith('c:/'):
+                    toolkey = dependency_name('.analysis/toolchain/wineprefix/drive_c/' +
+                                               dep.replace('\\', '/')[3:])
+                    need(toolkey in declared_tools, 'undeclared vendor OMF dependency ' + dep)
+                    checked(root, declared_tools[toolkey])
+                else:
+                    need(key in staged, 'undeclared staged OMF dependency ' + dep)
+                    n = staged[key]
+                    need(sha((work/n).read_bytes()) == source_meta[n]['sha256'] and
+                         len((work/n).read_bytes()) == source_meta[n]['bytes'],
+                         'consumed OMF dependency binding ' + n)
+            if rnd == 2:
+                need(raw == previous_objects[producer['output']], 'raw OMF pair')
+            else:
+                previous_objects[producer['output']] = raw
+            object_by_source[dependency_name(producer['source'])] = (producer, obj)
+            objects.append(dict(round=rnd, object=producer['output'], source=producer['source'],
+                                valid=True, dependencies_bound=True, producer=expected,
+                                sha256=sha(raw), bytes=len(raw), dependencies=obj['dependency_paths']))
+        target_raw = checked(root, manifest['target'])
+        candidate_raw = (work/'bin/th03/op.exe').read_bytes()
+        target, candidate = parse_mz(target_raw), parse_mz(candidate_raw)
+        need(target.valid and candidate.valid and candidate_raw == target_raw and
+             len(candidate_raw) == 63866 and len(candidate.program_image) == 59770,
+             'complete decoded target file equality')
+        need(target.header.header_size == candidate.header.header_size == 4096 and
+             candidate_raw[:4096] == target_raw[:4096], 'complete 4096-byte MZ header')
+        need(len(candidate.relocations) == len(target.relocations) == 607 and
+             [[r.segment, r.offset] for r in candidate.relocations] ==
+             [[r.segment, r.offset] for r in target.relocations], '607 literal ordered relocations')
+        maps = map_rows((work/'obj/th03/op.map').read_text())
+        need(maps, 'actual detailed CODE MAP')
+        for owner in owners:
+            start, end = owner['start'], owner['start']+owner['size']
+            need(end <= len(target.program_image), 'owner exceeds decoded program')
+            a, b = target.program_image[start:end], candidate.program_image[start:end]
+            need(a == b, 'complete owner raw bytes')
+            tr = relocation_rows(target, start, owner['size'])
+            need(tr == relocation_rows(candidate, start, owner['size']), 'owner ordered relocations')
+            contributions = sorted([row for row in maps if row['size'] and
+                                    row['start'] < end and row['start']+row['size'] > start],
+                                   key=lambda row: row['start'])
+            cursor, pieces = start, []
+            for row in contributions:
+                lo, hi = max(start, row['start']), min(end, row['start']+row['size'])
+                need(lo == cursor, 'complete unique owner MAP coverage')
+                key = dependency_name(row['module'])
+                need(key in object_by_source, 'owner assigned to non-project MAP context')
+                producer, obj = object_by_source[key]
+                lineage = owner_lineage(root, work, owner['source'], producer, obj)
+                pieces.append(dict(start=lo, size=hi-lo, map_row=row, object=producer['output'],
+                                   source=producer['source'], lineage=lineage))
+                cursor = hi
+            need(cursor == end and sum(p['size'] for p in pieces) == owner['size'],
+                 'missing complete owner MAP contribution')
+            owner['rounds'].append(dict(round=rnd, raw_equal=True, ordered_relocations_equal=True,
+                                       target_sha256=sha(a), candidate_sha256=sha(b),
+                                       map_covered_bytes=owner['size'], source_lineage_verified=True,
+                                       relocations=tr, contributions=pieces))
+        products.append(dict(round=rnd, exe=pin(root, (Path(manifest['work'])/'bin/th03/op.exe').as_posix()),
+                             map=pin(root, (Path(manifest['work'])/'obj/th03/op.map').as_posix()),
+                             decoded_bytes=63866, header_bytes=4096, literal_ordered_relocations=607,
+                             complete_decoded_target_equal=True, directly_packed=False))
+    need(products[0]['exe']['sha256'] == products[1]['exe']['sha256'] and
+         products[0]['map']['sha256'] == products[1]['map']['sha256'], 'raw EXE/MAP pairs')
+    validate_inventory(owners, cohort)
+    return dict(owners=owners, objects=objects, cold_products=products,
+                decoded_owner_count=45, decoded_authored_bytes=13221,
+                raw_OMF_pairs=30, new_authored_credit_bytes=0)
+

+def packing_lineage(root, cold_products):
+    _, proof = proofs(root)
+    manifest = json.loads(regular(root, proof['output']+'/manifest.json').read_bytes())
+    source = {k: manifest['repeat_inputs']['DECODED.EXE'][k] for k in ('path', 'bytes', 'sha256')}
+    raw = checked(root, source)
+    work = Path(proof['work'])
+    materialized = pin(root, (work/'DECODED.EXE').as_posix())
+    need(raw == checked(root, materialized) and len(raw) == 63866,
+         'actual source-produced packing input')
+    cold_paths = [p['exe']['path'] for p in cold_products]
+    need(source['path'] not in cold_paths and materialized['path'] not in cold_paths,
+         'do not recast separate source packing as cold-pair packing')
+    need(all(checked(root, p['exe']) == raw for p in cold_products),
+         'separate source input equals both actual cold EXEs')
+    packed = [pin(root, (work/p/'OP.EXE').as_posix()) for p in ('P1', 'P2')]
+    restored = [pin(root, (work/p/'OP.EXE').as_posix()) for p in ('R1', 'R2')]
+    canonical = pin(root, '.analysis/targets/th03/op.exe')
+    need(canonical['bytes'] == 36041 and all(checked(root, q) == checked(root, canonical)
+                                           for q in packed), 'two actual canonical packed outputs')
+    need(all(checked(root, q) == raw for q in restored), 'both actual restorations')
+    return dict(schema='op-separate-source-packing-lineage-v1',
+                cold_round_exes_directly_packed=False, separate_source_producer_exe=source,
+                materialized_source=materialized, cold_exes=[p['exe'] for p in cold_products],
+                separate_source_equals_both_cold_exes=True,
+                packed_outputs=packed, canonical_target=canonical, restored_outputs=restored,
+                source_producer_correction=proof['corrected_source_audit'],
+                original_source_native_completion=False,
+                corrected_source_producer_replay_required=True,
+                actual_packing_phases=5, packed_bytes=36041, restored_decoded_bytes=63866,
+                mixed_product_authored_credit_bytes=0, whole_product_ownership=False)
+

+def current_cohort(root, files=None):
+    config = json.loads(regular(root, COHORT, files).read_bytes())
+    need(config['schema'] == 'op-current-owner-cohort-v1' and
+         config['excluded_unit_ids'] == [IRAND] and config['new_authored_credit_bytes'] == 0,
+         'reviewed cohort boundary')
+    rows = list(csv.DictReader(regular(root, 'config/units.csv').read_text().splitlines()))
+    need(len(rows) == len({u['id'] for u in rows}), 'duplicate ledger IDs')
+    op = [u for u in rows if u['artifact'] == 'th03-op' and u['state'] != 'excluded']
+    need(len(op) == 46, 'active OP denominator')
+    owners = [descriptor(u) for u in op if u['state'] == 'source-present']
+    validate_inventory(owners, config['owners'])
+    other = [u for u in op if u['id'] not in {o['unit_id'] for o in owners}]
+    need(len(other) == 1 and other[0]['id'] == IRAND and not other[0]['source'] and
+         other[0]['origin'] == 'unknown' and int(other[0]['compare_size'], 0) == 42,
+         'IRAND ownership reclassification')
+    return config['owners']

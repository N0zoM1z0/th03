+def ledger_replay(root):
+    tracking = load_module(root, 'scripts/validate_tracking.py')
+    log = io.StringIO()
+    with contextlib.redirect_stdout(log):
+        rc = tracking.main(Path(root), validate_product=False)
+    need(rc == 0, 'current canonical ledger consistency')
+    return tracking, log.getvalue()

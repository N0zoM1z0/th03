+#!/usr/bin/env python3
+"""Prepare, verify or explicitly publish bounded current OP acceptance.
+
+Pure Python receipt/source/OMF/MAP checks only. No compile, link, packing,
+registry mutation, ledger edits or historical-publication rewriting.
+"""
+from pathlib import Path
+import argparse
+import datetime
+import hashlib
+import importlib.util
+import json
+import sys
+import tomllib
+
+sys.dont_write_bytecode = True
+
+
+def bootstrap(root, files):
+    # No repository code is imported before its reviewed helper manifest passes.
+    manifest = files/'config/op_product_acceptance/helper-bindings.json'
+    if not manifest.is_file():
+        manifest = root/'config/op_product_acceptance/helper-bindings.json'
+    if not manifest.is_file() or any(p.is_symlink() for p in (manifest, *manifest.parents)):
+        raise ValueError('missing regular reviewed helper manifest')
+    pins = json.loads(manifest.read_bytes())['pins']
+    names = [p['path'] for p in pins]
+    required = {'scripts/lib/op_product_acceptance.py',
+                'scripts/replay_th03_op_product_acceptance.py', 'scripts/lib/__init__.py'}
+    if len(names) != len(set(names)) or not required <= set(names):
+        raise ValueError('incomplete reviewed helper closure')
+    for pin in pins:
+        name = Path(pin['path'])
+        if name.is_absolute() or '..' in name.parts or '\\' in pin['path']:
+            raise ValueError('unsafe reviewed helper path')
+        path = files/name if (files/name).exists() else root/name
+        if not path.is_file() or any(p.is_symlink() for p in (path, *path.parents)):
+            raise ValueError('missing regular helper '+pin['path'])
+        raw = path.read_bytes()
+        if len(raw) != pin['bytes'] or hashlib.sha256(raw).hexdigest() != pin['sha256']:
+            raise ValueError('reviewed helper drift '+pin['path'])
+    sys.path.insert(0, str(root/'scripts'))
+    path = files/'scripts/lib/op_product_acceptance.py'
+    if not path.exists():
+        path = root/'scripts/lib/op_product_acceptance.py'
+    spec = importlib.util.spec_from_file_location('current_op_acceptance', path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    module.helper_bindings(root, files)
+    return module
+
+
+def fresh_directory(root, relative):
+    if relative.is_absolute() or '..' in relative.parts or not relative.parts or relative.parts[0] != '.analysis':
+        raise ValueError('new repository-local analysis directory required')
+    path = root/relative
+    if path.exists() or any(p.is_symlink() for p in (path, *path.parents)):
+        raise ValueError('output already exists or is not regular')
+    path.mkdir(parents=True)
+    return path
+
+
+def prepare(root, files, output, lib):
+    out = fresh_directory(root, output)
+    # Existing replay modules themselves check immutable proof and input pins
+    # before evaluating their retained historical helper code.
+    cold = lib.load_module(root, 'scripts/replay_th03_op_fullcold_exact.py')
+    packing = lib.load_module(root, 'scripts/replay_th03_op_source_packing.py')
+    cold_result = cold.replay(root)
+    lib.validate_cold_witness(cold_result)
+    packing_result = packing.replay(root)
+    lib.validate_packing_witness(packing_result)
+    current_source = cold.check_current_sources(root)
+    cohort = lib.current_cohort(root, files)
+    audit = lib.physical_audit(root, cohort)
+    lineage = lib.packing_lineage(root, audit['cold_products'])
+    from lib.op_diet_lineage import verify_diet_lineage
+    from lib.pc98 import describe_blob
+    identity, identity_pins = verify_diet_lineage(root, describe_blob)
+    toolchain = lib.tool_identity(root)
+    _, ledger = lib.ledger_replay(root)
+    values = {'cold-replay.json': cold_result, 'packing-replay.json': packing_result,
+              'actual-cold-owner-audit.json': audit, 'packing-lineage.json': lineage,
+              'target-identity.json': identity, 'toolchain-identity.json': toolchain}
+    for name, value in values.items():
+        (out/name).write_text(json.dumps(value, indent=2)+'\n')
+    (out/'ledger.log').write_text(ledger)
+    evidence = [lib.pin(root, (out/name).relative_to(root).as_posix())
+                for name in (*values, 'ledger.log')]
+    pins = lib.input_bindings(root, files, identity_pins)
+    policy = tomllib.loads((root/'config/oracles.toml').read_text())
+    specs = {r['id']: r for r in policy['oracles']}
+    witness = {
+        'target-identity': 'target-identity.json', 'format-integrity': 'target-identity.json',
+        'boundary-ownership': 'actual-cold-owner-audit.json',
+        'toolchain-identity': 'toolchain-identity.json', 'toolchain-replay': 'cold-replay.json',
+        'object-format-integrity': 'actual-cold-owner-audit.json',
+        'cold-build-determinism': 'cold-replay.json',
+        'layout-relocations': 'actual-cold-owner-audit.json', 'raw-bytes': 'actual-cold-owner-audit.json',
+        'ledger-consistency': 'ledger.log', 'cold-aggregate-replay': 'cold-replay.json'}
+    gates = {gate: dict(result='pass', evidence_class=specs[gate]['accepts_evidence_classes'][0],
+                        witness=(out/name).relative_to(root).as_posix())
+             for gate, name in witness.items()}
+    now = datetime.datetime.now(datetime.timezone.utc).isoformat().replace('+00:00', 'Z')
+    publication = dict(
+        schema='op-product-acceptance-publication-v1', state='review-ready',
+        scope='current-45-decoded-owners-and-separate-mixed-product',
+        target_provenance='candidate-local-attested', factory_accepted=False,
+        canonical_credit_changed=False, new_authored_credit_bytes=0, whole_game_percentage=None,
+        whole_product_ownership=False, runtime_rerun=False, observed_utc=now,
+        owners=audit['owners'], gates=gates, input_bindings=pins, evidence_bindings=evidence,
+        current_source_compatibility=current_source, packing_lineage=lineage,
+        packing_witness=(out/'packing-replay.json').relative_to(root).as_posix(),
+        packing_lineage_witness=(out/'packing-lineage.json').relative_to(root).as_posix())
+    publication['inputs'] = {p['path']: p['sha256'] for p in pins+evidence}
+    publication['owner_oracles'] = lib.evidence_rows(
+        publication['owners'], gates, policy, pins, evidence, now)
+    result = lib.verify(root, publication, files, allow_review=True)
+    review = out/'review.json'
+    review.write_text(json.dumps(publication, indent=2)+'\n')
+    return dict(review=review.relative_to(root).as_posix(), review_sha256=lib.sha(review.read_bytes()),
+                native_invocations=0, published=False, status=result)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', type=Path, default=Path.cwd())
+    parser.add_argument('--files', type=Path)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument('--prepare', type=Path)
+    mode.add_argument('--verify', type=Path)
+    mode.add_argument('--publish', type=Path)
+    parser.add_argument('--review-sha256')
+    parser.add_argument('--full-replay', action='store_true')
+    args = parser.parse_args()
+    root = args.root.resolve()
+    files = args.files.resolve() if args.files else root
+    # Publishing requires installed files, and an exact, explicit reviewed digest.
+    if args.publish:
+        if files != root or not args.review_sha256 or args.publish.is_absolute() or '..' in args.publish.parts or not args.publish.parts or args.publish.parts[0] != '.analysis':
+            raise ValueError('publish requires installed files and an exact reviewed analysis path/digest')
+        raw = (root/args.publish).read_bytes()
+        if hashlib.sha256(raw).hexdigest() != args.review_sha256:
+            raise ValueError('review digest mismatch before imports')
+    lib = bootstrap(root, files)
+    if args.prepare:
+        if args.full_replay:
+            raise ValueError('prepare already replays every actual receipt')
+        result = prepare(root, files, args.prepare, lib)
+    else:
+        relative = args.publish or args.verify
+        publication = json.loads(lib.regular(root, relative.as_posix()).read_bytes())
+        if args.publish:
+            lib.need(publication['state'] == 'review-ready', 'review-to-publication transition')
+            destination = root/lib.PUBLICATION
+            lib.need(not destination.exists() and destination.parent.is_dir() and
+                     not any(p.is_symlink() for p in (destination, *destination.parents)),
+                     'new fixed publication destination required')
+            lib.verify(root, publication, allow_review=True, full_replay=args.full_replay)
+            publication['state'] = 'repository-local-accepted'
+            # Verify final state before the sole new publication write.
+            result = lib.verify(root, publication)
+            with destination.open('x') as stream:
+                json.dump(publication, stream, indent=2)
+                stream.write('\n')
+            result = dict(result, publication=lib.PUBLICATION, native_invocations=0, published=True)
+        else:
+            result = lib.verify(root, publication, files, allow_review=True,
+                                full_replay=args.full_replay)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()

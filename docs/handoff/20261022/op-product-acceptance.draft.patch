+
+def dependency_name(name):
+    return name.replace('\\', '/').casefold()
+
+
+def map_rows(text):
+    pattern = re.compile(
+        r'^\s*([0-9A-Fa-f]{4}):([0-9A-Fa-f]{4})\s+([0-9A-Fa-f]+)\s+'
+        r'C=CODE\s+S=(\S+)\s+G=\S+\s+M=(\S+)\s+ACBP=(\S+)\s*$', re.M)
+    return [dict(segment=int(s, 16), offset=int(o, 16), start=int(s, 16)*16+int(o, 16),
+                 size=int(n, 16), name=name, module=module.replace('\\', '/'), acbp=acbp)
+            for s, o, n, name, module, acbp in pattern.findall(text)]
+
+
+def relocation_rows(image, start, size):
+    end = start + size
+    need(not any(r.linear < end and r.linear+2 > start and
+                 not (start <= r.linear and r.linear+2 <= end) for r in image.relocations),
+         'straddling owner relocation')
+    return [[r.segment, r.offset, int.from_bytes(image.program_image[r.linear:r.linear+2], 'little')]
+            for r in image.relocations if start <= r.linear < end]
+
